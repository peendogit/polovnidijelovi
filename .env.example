PORT=3030
SECRET=promijeni-me
NODE_ENV=production
SITE_URL=https://polovnidijelovi.com

# Email (potvrda emaila, zaboravljena lozinka, obavijesti) — Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="polovnidijelovi.com <noreply@polovnidijelovi.com>"
# proba: node --no-warnings tools/mail-test.js tvoj@email.com

# Kopija van servera — upisuje je sama skripta tools/offsite-setup.sh
# OFFSITE_REMOTE=pdkopija:polovnidijelovi-kopija

# Telegram obavijesti adminu (npr. novi zahtjev za isticanje) — isti bot kao za shop
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Prijava sa Google (Google Cloud konzola -> OAuth klijent). Redirect URI: https://polovnidijelovi.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stranica Privatnost: ko je vlasnik sajta i kontakt za lične podatke
SITE_OWNER=
CONTACT_EMAIL=
