PORT=3030
SECRET=promijeni-me
NODE_ENV=production
SITE_URL=https://polovnidijelovi.com

# Email (potvrda emaila i zaboravljena lozinka) — Gmail sa "lozinkom za aplikaciju"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Kopija van servera — upisuje je sama skripta tools/offsite-setup.sh
# OFFSITE_REMOTE=pdkopija:polovnidijelovi-kopija

# Telegram obavijesti adminu (npr. novi zahtjev za isticanje) — isti bot kao za shop
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Prijava sa Google (Google Cloud konzola -> OAuth klijent). Redirect URI: https://polovnidijelovi.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
